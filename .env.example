# Required for live NVIDIA NIM agents (free key at https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-key-here

# Live market fares (Travelpayouts / Aviasales Data API — free affiliate token)
# Get yours: https://www.travelpayouts.com/developers/api
# A public docs demo token is used if unset (fine for development).
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# Optional NDC/GDS-style offers (sandbox or live): https://duffel.com
DUFFEL_ACCESS_TOKEN=
# Set to 0 to force the demo catalog even when tokens exist
LIVE_FARES=1

# Optional model overrides (free hosted NIM catalog)
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_MODEL_INTENT=meta/llama-3.1-8b-instruct
NVIDIA_MODEL_SPECIALIST=nvidia/llama-3.1-nemotron-nano-8b-v1
NVIDIA_MODEL_CONCIERGE=nvidia/llama-3.3-nemotron-super-49b-v1.5

# Server
PORT=3000
NODE_ENV=development
SKIP_MONGODB=true

# Existing Assistant integrations (optional for SkyAgent)
MONGODB_URI=
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
SERPER_API_KEY=

# Mobile (Expo) — use your machine LAN IP when testing on a physical iPhone
EXPO_PUBLIC_API_URL=http://localhost:3000
